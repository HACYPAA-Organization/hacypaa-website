{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hacypaa-local-development",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "vars": {
    "ENVIRONMENT": "development",
    "FULFILLMENT_MODE": "disabled",
    "PREREG_PRICE_CENTS": "2500",
    "PUBLIC_SITE_URL": "http://127.0.0.1:5500",
    "PREREG_FROM_EMAIL": "HACYPAA Local <test@example.invalid>"
  },
  "d1_databases": [{
    "binding": "ORDERS_DB",
    "database_name": "hacypaa-local-development",
    "database_id": "00000000-0000-0000-0000-000000000002"
  }],
  "ratelimits": [{
    "name": "PUBLIC_WRITE_LIMITER",
    "namespace_id": "910098",
    "simple": { "limit": 30, "period": 60 }
  }]
}

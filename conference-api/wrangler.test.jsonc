{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hacypaa-local-security-tests",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "vars": {
    "ENVIRONMENT": "test",
    "BOT_PROTECTION_MODE": "disabled",
    "RECIPIENT_QUOTA_MODE": "disabled",
    "FULFILLMENT_MODE": "disabled",
    "PREREG_PRICE_CENTS": "2500",
    "PUBLIC_SITE_URL": "https://hacypaa.us",
    "PREREG_FROM_EMAIL": "HACYPAA Tests <test@example.invalid>"
  },
  "d1_databases": [{
    "binding": "ORDERS_DB",
    "database_name": "hacypaa-local-security-tests",
    "database_id": "00000000-0000-0000-0000-000000000001"
  }, {
    "binding": "MIGRATION_TEST_DB",
    "database_name": "hacypaa-local-migration-tests",
    "database_id": "00000000-0000-0000-0000-000000000003"
  }],
  "ratelimits": [{
    "name": "PUBLIC_WRITE_LIMITER",
    "namespace_id": "910099",
    "simple": { "limit": 30, "period": 60 }
  }]
}
